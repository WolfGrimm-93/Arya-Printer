        <!-- ==================== FLUJO PRINCIPAL ==================== -->
        <mxCell id="flow_title" value="&lt;b&gt;Flujo de Impresion:&lt;/b&gt;&lt;br&gt;1. Cliente envia POST /api/v1/print&lt;br&gt;2. FastAPI valida con Pydantic&lt;br&gt;3. CommandBuilder genera bytes ESC/POS&lt;br&gt;4. Se selecciona el Adapter correcto&lt;br&gt;5. Adapter envia datos al dispositivo&lt;br&gt;6. Se registra en PrintHistory" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#e6d0de;strokeColor=#996185;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="1">
